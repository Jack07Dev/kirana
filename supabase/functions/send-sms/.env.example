# Supabase Edge Function secrets (Dashboard → Edge Functions → send-sms → Secrets)
# Do NOT commit real values.

# From Auth → Hooks → Send SMS → Generate secret (paste full value including v1,whsec_ prefix)
SEND_SMS_HOOK_SECRET=v1,whsec_your_hook_secret

# Provider: fast2sms (default) or msg91
SMS_PROVIDER=fast2sms

# Fast2SMS — https://www.fast2sms.com/dashboard/dev-api (prepaid wallet, India OTP route)
FAST2SMS_API_KEY=your-dev-api-key

# MSG91 (optional) — only if SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
