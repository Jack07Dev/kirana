{
  "expo": {
    "name": "Kirana",
    "slug": "kirana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kirana",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jackdev007.kirana",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find kirana stores that deliver to your location.",
        "NSCameraUsageDescription": "Scan product barcodes for your store inventory.",
        "NSPhotoLibraryUsageDescription": "Add photos for your store and products.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.jackdev007.kirana",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find nearby kirana stores that deliver to you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E7D32"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcodes to add products quickly."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload store and product photos."
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5f6cf6c9-2da0-4b44-81d8-92fa10a29584"
      }
    },
    "owner": "jackdev007"
  }
}
